<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>plato_mppi</name>
  <version>0.1.0</version>
  <description>ROS adapter that drives the Plato hand impedance controller from mppi_core.</description>
  <maintainer email="dongho@utexas.edu">dk</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>eigen3_cmake_module</depend>
  <depend>Eigen3</depend>
  <depend>geometry_msgs</depend>
  <depend>mppi_core</depend>
  <depend>pinocchio</depend>
  <depend>plato_description</depend>
  <depend>rclcpp</depend>
  <depend>sdr_grasp_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>wbc_core</depend>
  <depend>wbc_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
