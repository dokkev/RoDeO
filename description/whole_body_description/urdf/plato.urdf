      <origin rpy="1.5708 -1.5708 0" xyz="0.0275353 -8.61887e-05 -0.00673205"/>
      <geometry>
        <mesh filename="meshes/col_middle_proximal.stl"/>
      </geometry>
    </collision>
  </link>
  <!-- middle_distal -->
  <link name="aristo_middle_distal">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.0330685 0.00101822 0.00300906"/>
      <mass value="0.0219871"/>
      <inertia ixx="1.21431e-06" ixy="1.08631e-07" ixz="2.69395e-09" iyy="9.73575e-06" iyz="2.19882e-10" izz="9.42439e-06"/>
    </inertial>
    <visual>
      <origin rpy="-1.5708 -1.5708 0" xyz="-0.0330685 0.00101822 0.00300906"/>
      <geometry>
        <mesh filename="meshes/middle_distal.stl"/>
      </geometry>
      <material name="middle_distal_parts_material">
        <color rgba="0.670015 0.670243 0.668779 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="-1.5708 -1.5708 0" xyz="-0.0330685 0.00101822 0.00300906"/>
      <geometry>
        <mesh filename="meshes/col_middle_distal.stl"/>
      </geometry>
    </collision>
  </link>
  <!-- middle_distal_tactile: tactile sensor frame 4.73 cm distal of middle_distal -->
  <link name="aristo_middle_distal_tactile"/>
  <joint name="aristo_middle_distal_to_tactile" type="fixed">
    <!-- translate 0.0473 m (4.73 cm) along the distal link local +x -->
    <!-- orient tactile frame so Z+ points downward while keeping +X forward: rotate pi around X -->
    <origin rpy="0 -1.57 1.57" xyz="-0.0523 -0.01 -0.0025"/>
    <parent link="aristo_middle_distal"/>
    <child link="aristo_middle_distal_tactile"/>
  </joint>
  <!-- middle_fingertip: fingertip frame at the end of middle finger -->
  <link name="aristo_middle_fingertip"/>
  <joint name="aristo_middle_distal_to_fingertip" type="fixed">
    <origin rpy="0 0 0" xyz="-0.066 0 0"/>
    <parent link="aristo_middle_distal"/>
    <child link="aristo_middle_fingertip"/>
  </joint>
  <joint name="aristo_connector_to_hand_mount" type="fixed">
    <origin rpy="0 -1.57 3.1416" xyz="0 0 0.01"/>
    <parent link="end_effector"/>
    <child link="aristo_hand_mount"/>
  </joint>
