<?xml version="1.0"?>
<!-- Full URDF for Plato (Optimo arm + optional Aristo hand), including controls -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="plato">
    <xacro:arg name="use_aristo_hand" default="false" />
    <xacro:arg name="use_sim_hardware" default="false" />
    <xacro:arg name="use_mujoco_sim" default="false" />
    <xacro:arg name="mujoco_model" default="" />
    <xacro:arg name="headless" default="false" />
    <xacro:arg name="prefix" default=""/>
    <xacro:arg name="robot_index" default="0"/>
    <xacro:arg name="ns" default="plato"/>
    <!-- Import files -->
    <xacro:include filename="$(find plato_description)/urdf/xacro/optimo.common.xacro" />
    <xacro:include filename="$(find plato_description)/urdf/xacro/optimo.xacro" />
    <xacro:include filename="$(find plato_description)/urdf/xacro/aristo_description.xacro" />
    <xacro:include filename="$(find plato_description)/urdf/ros2_control/optimo.ros2_control.xacro" />
    <xacro:include filename="$(find plato_description)/urdf/ros2_control/plato_mujoco.xacro" />

    <mujoco>
      <compiler meshdir="meshes/"/>
    </mujoco>

    <link name="world"/>

    <!-- Add the arm, optional hand, and ros2_control -->
    <xacro:optimo
      prefix="$(arg prefix)"/>
    <xacro:if value="$(arg use_aristo_hand)">
      <xacro:aristo_description
        prefix="aristo_" />
      <joint name="aristo_connector_to_hand_mount" type="fixed">
        <origin xyz="0 0 0.01" rpy="0 -1.57 3.1416"/>
        <parent link="end_effector"/>
        <child link="aristo_hand_mount"/>
      </joint>
    </xacro:if>

    <!-- MuJoCo sim: unified ros2_control with all 15 joints -->
    <xacro:if value="$(arg use_mujoco_sim)">
      <ros2_control name="MujocoSystem" type="system">
        <xacro:plato_mujoco_hardware
            mujoco_model="$(arg mujoco_model)"
            headless="$(arg headless)" />

        <!-- Arm joints (7-DOF) -->
        <joint name="joint1">
            <command_interface name="position" />
            <command_interface name="velocity" />
            <command_interface name="effort">
                <param name="min">-79</param>
                <param name="max">79</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="joint2">
            <command_interface name="position" />
            <command_interface name="velocity" />
            <command_interface name="effort">
                <param name="min">-95</param>
                <param name="max">95</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="joint3">
            <command_interface name="position" />
            <command_interface name="velocity" />
            <command_interface name="effort">
                <param name="min">-32</param>
                <param name="max">32</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="joint4">
            <command_interface name="position" />
            <command_interface name="velocity" />
            <command_interface name="effort">
                <param name="min">-40</param>
                <param name="max">40</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="joint5">
            <command_interface name="position" />
            <command_interface name="velocity" />
            <command_interface name="effort">
                <param name="min">-15</param>
                <param name="max">15</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="joint6">
            <command_interface name="position" />
            <command_interface name="velocity" />
            <command_interface name="effort">
                <param name="min">-15</param>
                <param name="max">15</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="joint7">
            <command_interface name="position" />
            <command_interface name="velocity" />
            <command_interface name="effort">
                <param name="min">-15</param>
                <param name="max">15</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>

        <!-- Hand joints (8-DOF) -->
        <joint name="aristo_joint1">
            <command_interface name="position" />
            <command_interface name="velocity" />
            <command_interface name="effort">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="aristo_joint2">
            <command_interface name="position" />
            <command_interface name="velocity" />
            <command_interface name="effort">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="aristo_joint3">
            <command_interface name="position" />
            <command_interface name="velocity" />
            <command_interface name="effort">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="aristo_joint4">
            <command_interface name="position" />
            <command_interface name="velocity" />
            <command_interface name="effort">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="aristo_joint5">
            <command_interface name="position" />
            <command_interface name="velocity" />
            <command_interface name="effort">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="aristo_joint6">
            <command_interface name="position" />
            <command_interface name="velocity" />
            <command_interface name="effort">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="aristo_joint7">
            <command_interface name="position" />
            <command_interface name="velocity" />
            <command_interface name="effort">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="aristo_joint8">
            <command_interface name="position" />
            <command_interface name="velocity" />
            <command_interface name="effort">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
      </ros2_control>
    </xacro:if>

    <!-- Non-MuJoCo: use original Ignition/hardware ros2_control (arm only) -->
    <xacro:unless value="$(arg use_mujoco_sim)">
      <xacro:optimo_ros2_control use_sim_hardware="$(arg use_sim_hardware)" prefix="$(arg prefix)" robot_index="$(arg robot_index)" ns="$(arg ns)" />
    </xacro:unless>

</robot>
